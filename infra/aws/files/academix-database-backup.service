[Unit]
Description=Verified AcademiX database backup to private S3
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/opt/academix-backup/database-backup.sh
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
